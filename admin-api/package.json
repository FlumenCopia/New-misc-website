{
  "name": "admin-api",
  "version": "1.0.0",
  "description": "MiscArchive CMS Admin API Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs = require('fs'); fs.mkdirSync('dist/data', { recursive: true }); fs.copyFileSync('src/data/websiteSeedData.json', 'dist/data/websiteSeedData.json');\"",
    "start": "node dist/server.js",
    "seed:admin": "tsx src/utils/seedAdmin.ts",
    "seed:website": "tsx src/utils/seedWebsite.ts",
    "seed:all": "tsx src/utils/seedAll.ts",
    "generate:seed": "tsx src/scripts/generateWebsiteSeed.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
